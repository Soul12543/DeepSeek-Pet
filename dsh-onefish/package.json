{
  "name": "dsh-onefish",
  "version": "0.1.0",
  "private": true,
  "description": "一条鱼：把 DSH 的多个 shell.overlay 浮层（扑克 / 塔罗 / 宠物）收进同一只鲸鱼的标签页容器",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  }
}
